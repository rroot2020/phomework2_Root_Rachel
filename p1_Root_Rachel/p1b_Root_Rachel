def parse_functions(file):
    f = open(file, "r")
    lines = f.readlines()
    f.close()

    funcs = []

    for e in range(len(lines)):
        line = lines[e]

        if line.startswith("def "):
            no_def = line.replace("def ", "")
            name = no_def.split("(")[0].strip()

            start = no_def.find("(")
            end = no_def.find(")")
            elements = no_def[start + 1 : end]

            body = [line]
            for j in range(e + 1, len(lines)):
                next_line = lines[j]

                if next_line.startswith("def ") or (
                    next_line.strip()
                    and not next_line.startswith(" ")
                    and not next_line.startswith("\t")
                ):
                    break
               
                if next_line.strip() and not next_line.strip().startswith("#"):
                    body.append(next_line)
            
            funcs.append((name, e + 1, elements, "".join(body)))
    
    funcs.sort()
    final_tuples = []
    for item in funcs:
        final_tuples.append((item[1], item[0], item[2], item[3]))

    return tuple(final_tuples)

