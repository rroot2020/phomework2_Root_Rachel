def add_friend(sn, user1, user2):
    
    if user1 not in sn or user2 not in sn:
        return False
    
    if user2 in sn[user1][1] or user1 in sn[user2][1]:
        return False
    
    sn[user1][1].append(user2)
    sn[user2][1].append(user1)
    return True

my_network = {
    "Rachel": ("Rachel Root", ["Seth"]),
    "Seth": ("Seth Bernoir", ["Rachel"]),
    "alora": ("Alora Bernoir", []),
}

print(add_friend(my_network, "Seth", "alora"))  


print(add_friend(my_network, "Rachel", "fake_user"))  
